<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/gap_m"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/gap_xs">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/add_step_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/builder_step_hint"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/sage_soft">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/add_step_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="@color/ink" />

    </com.google.android.material.textfield.TextInputLayout>

</RelativeLayout>
