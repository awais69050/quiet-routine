<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient">

    <ImageView
        android:id="@+id/menu_art"
        android:layout_width="0dp"
        android:layout_height="@dimen/menu_art_height"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.62" />

    <TextView
        android:id="@+id/menu_title_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/status_bar_pad"
        android:text="@string/menu_title_top"
        android:textAppearance="@style/TextAppearance.App.Display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/menu_title_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:text="@string/menu_title_bottom"
        android:textAppearance="@style/TextAppearance.App.Display"
        android:textColor="@color/sage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_title_top" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_settings"
        style="@style/Widget.App.Button.Icon"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/status_bar_pad"
        android:layout_marginEnd="@dimen/gap_m"
        android:contentDescription="@string/cd_settings"
        app:icon="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_rule"
        style="@style/Widget.App.Hairline"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_title_bottom" />

    <TextView
        android:id="@+id/menu_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_s"
        android:text="@string/menu_subtitle"
        android:textAppearance="@style/TextAppearance.App.Label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_rule" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_m"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/gap_xs"
        app:layout_constraintBottom_toTopOf="@id/menu_stats"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_subtitle" />

    <LinearLayout
        android:id="@+id/menu_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/gap_m"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/menu_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.quietroutine.app.core.ui.StatCardView
            android:id="@+id/stat_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:statAccent="@color/sage"
            app:statLabel="@string/stat_streak" />

        <com.quietroutine.app.core.ui.StatCardView
            android:id="@+id/stat_done_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_s"
            android:layout_weight="1"
            app:statAccent="@color/terracotta"
            app:statLabel="@string/stat_done_today" />

        <com.quietroutine.app.core.ui.StatCardView
            android:id="@+id/stat_routines"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_s"
            android:layout_weight="1"
            app:statAccent="@color/sage_soft"
            app:statLabel="@string/stat_routines" />

    </LinearLayout>

    <TextView
        android:id="@+id/menu_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/gap_s"
        android:text="@string/menu_hint"
        android:textColor="@color/ink_muted"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/menu_cta"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_cta"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_primary"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/gap_s"
        android:text="@string/cta_start"
        app:layout_constraintBottom_toTopOf="@id/menu_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/menu_secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/gap_l"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_new_routine"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_secondary"
            android:layout_weight="1"
            android:text="@string/cta_new_routine" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_history"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_secondary"
            android:layout_marginStart="@dimen/gap_s"
            android:layout_weight="1"
            android:text="@string/cta_history" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
