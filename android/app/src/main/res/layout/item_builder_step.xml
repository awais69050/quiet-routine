<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_m"
        android:paddingEnd="@dimen/gap_xs">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/gap_s"
            android:paddingBottom="@dimen/gap_s">

            <TextView
                android:id="@+id/builder_step_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/builder_step_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label.Tiny" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/builder_step_up"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_move_up"
            app:icon="@drawable/ic_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/builder_step_down"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_move_down"
            app:icon="@drawable/ic_down" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/builder_step_remove"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_remove_step"
            app:icon="@drawable/ic_remove" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
