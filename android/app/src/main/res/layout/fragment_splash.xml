<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <ImageView
        android:id="@+id/splash_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/splash_veil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/splash_veil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/splash_mark"
        android:layout_width="@dimen/brand_mark"
        android:layout_height="@dimen/brand_mark"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_brand_mark"
        app:layout_constraintBottom_toTopOf="@id/splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_l"
        android:gravity="center"
        android:text="@string/splash_title"
        android:textAppearance="@style/TextAppearance.App.Display.Splash"
        app:layout_constraintBottom_toTopOf="@id/splash_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_mark" />

    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_s"
        android:gravity="center"
        android:letterSpacing="0.22"
        android:text="@string/splash_subtitle"
        android:textColor="@color/splash_text_soft"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/splash_lines"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title" />

    <LinearLayout
        android:id="@+id/splash_lines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_xl"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_subtitle">

        <View
            android:id="@+id/splash_line_one"
            android:layout_width="120dp"
            android:layout_height="1dp"
            android:background="@color/splash_line" />

        <View
            android:id="@+id/splash_line_two"
            android:layout_width="92dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/gap_s"
            android:background="@color/splash_line" />

        <View
            android:id="@+id/splash_line_three"
            android:layout_width="64dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/gap_s"
            android:background="@color/splash_line" />

    </LinearLayout>

    <TextView
        android:id="@+id/splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_m"
        android:accessibilityLiveRegion="polite"
        android:letterSpacing="0.18"
        android:text="@string/splash_loading"
        android:textColor="@color/splash_text_soft"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/splash_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splash_progress"
        android:layout_width="@dimen/splash_indicator_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        android:indeterminate="true"
        app:indicatorColor="@color/terracotta"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="@color/splash_track"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
