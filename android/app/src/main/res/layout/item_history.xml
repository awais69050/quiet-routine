<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingTop="@dimen/gap_xs"
    android:paddingBottom="@dimen/gap_xs">

    <ImageView
        android:id="@+id/history_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/cd_step_done"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_s"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/history_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Label.Tiny" />

        <TextView
            android:id="@+id/history_routine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/ink" />

    </LinearLayout>

    <TextView
        android:id="@+id/history_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_s"
        android:textColor="@color/sage"
        android:textSize="13sp" />

</LinearLayout>
