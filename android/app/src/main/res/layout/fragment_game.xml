<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/game_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:minHeight="116dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_s"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingEnd="@dimen/gap_m"
        android:paddingBottom="@dimen/gap_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_back"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:id="@+id/game_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_xs"
            android:layout_weight="1"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/game_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:letterSpacing="0.08"
            android:textColor="@color/sage"
            android:textSize="13sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/game_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/game_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.18"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_active" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/game_step_card"
                style="@style/Widget.App.Card.Step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gap_m"
                    android:paddingTop="22dp"
                    android:paddingEnd="@dimen/gap_m"
                    android:paddingBottom="22dp">

                    <ImageView
                        android:id="@+id/game_sprite"
                        android:layout_width="@dimen/sprite_step"
                        android:layout_height="@dimen/sprite_step"
                        android:contentDescription="@string/cd_step_icon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sprite_sunrise" />

                    <TextView
                        android:id="@+id/game_step_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_m"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.App.Headline" />

                    <TextView
                        android:id="@+id/game_step_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_xs"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="@dimen/timer_ring"
                        android:layout_height="@dimen/timer_ring"
                        android:layout_marginTop="@dimen/gap_m">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/game_timer_ring"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            app:indicatorColor="@color/terracotta"
                            app:indicatorSize="@dimen/timer_ring"
                            app:trackColor="@color/paper_shade"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="5dp" />

                        <TextView
                            android:id="@+id/game_timer_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.App.Numeric.Timer" />

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.quietroutine.app.core.ui.StepProgressView
                android:id="@+id/game_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/gap_m" />

            <TextView
                android:id="@+id/game_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/game_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_controls"
        android:minHeight="@dimen/controls_height"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/gap_l"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/gap_l">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_done"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:text="@string/cta_done" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_skip"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_secondary"
                android:layout_weight="1"
                android:text="@string/cta_skip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_finish"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_secondary"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1"
                android:text="@string/cta_finish" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
