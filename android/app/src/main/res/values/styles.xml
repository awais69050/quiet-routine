<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.App.Display.Medium">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.App.Display.Splash">
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/splash_text</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="TextAppearance.App.Label.Tiny">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.App.Numeric" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/sage</item>
    </style>

    <style name="TextAppearance.App.Numeric.Large">
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.App.Numeric.Timer">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/on_sage</item>
        <item name="backgroundTint">@color/sage</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="rippleColor">@color/ripple_terracotta</item>
        <item name="elevation">2dp</item>
        <item name="iconTint">@color/on_sage</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.App.Button.Primary.Accent">
        <item name="backgroundTint">@color/terracotta</item>
        <item name="android:textColor">@color/on_terracotta</item>
        <item name="iconTint">@color/on_terracotta</item>
        <item name="rippleColor">@color/ripple_sage</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/sage</item>
        <item name="strokeColor">@color/sage_soft</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="cornerRadius">@dimen/card_radius</item>
        <item name="rippleColor">@color/ripple_sage</item>
        <item name="iconTint">@color/sage</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.App.Button.Secondary.Warn">
        <item name="android:textColor">@color/terracotta</item>
        <item name="strokeColor">@color/terracotta</item>
        <item name="iconTint">@color/terracotta</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconTint">@color/sage</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/card_radius</item>
        <item name="rippleColor">@color/ripple_sage</item>
    </style>

    <style name="Widget.App.Toggle.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="strokeColor">@color/sage_soft</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="cornerRadius">@dimen/card_radius</item>
        <item name="rippleColor">@color/ripple_terracotta</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="rippleColor">@color/ripple_terracotta</item>
    </style>

    <style name="Widget.App.Card.Step">
        <item name="cardCornerRadius">@dimen/card_radius_lg</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Widget.App.Hairline" parent="">
        <item name="android:layout_width">@dimen/rule_width</item>
        <item name="android:layout_height">@dimen/hairline</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
